# OpenRouter API key (provided via InsForge) — required for AI analysis.
OPENROUTER_API_KEY=
# OpenRouter model id, e.g. anthropic/claude-sonnet-4.5 or deepseek/deepseek-chat
OPENROUTER_MODEL=
# Path to the kubeconfig for the target cluster (leave empty to use the default ~/.kube/config).
KUBECONFIG_PATH=
CORS_ORIGINS=http://localhost:3000
