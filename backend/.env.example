# OpenRouter API key (provided via InsForge) — required for AI analysis.
OPENROUTER_API_KEY=
# OpenRouter model id, e.g. anthropic/claude-sonnet-4.5 or deepseek/deepseek-chat
OPENROUTER_MODEL=
# Path to the kubeconfig for the target cluster (leave empty to use the default ~/.kube/config).
KUBECONFIG_PATH=
CORS_ORIGINS=http://localhost:3000

# InsForge project URL. When set, the API requires a signed-in InsForge user.
INSFORGE_URL=
# InsForge admin API key (server-side only) for saving investigation history.
INSFORGE_API_KEY=
# Read-only kubectl tool calls the agent may make to dig deeper (0 = single-shot, the default).
# Experimental: not yet measured by the evals.
AGENT_MAX_TOOL_CALLS=0
